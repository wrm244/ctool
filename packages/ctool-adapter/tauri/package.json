{
    "name": "ctool-adapter-tauri",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "scripts": {
        "build": "pnpm exec tsdown",
        "init": "node ./dist/init.cjs && pnpm tauri icon ./dist/web/icon/icon_1024.png",
        "release": "pnpm run init && pnpm tauri build && node ./dist/release.cjs",
        "adapter-build": "pnpm run build",
        "platform-release": "pnpm run release"
    },
    "dependencies": {
        "@tauri-apps/api": "^2.12.4",
        "@tauri-apps/plugin-clipboard-manager": "~2.5.0",
        "@tauri-apps/plugin-dialog": "^2.8.3",
        "@tauri-apps/plugin-fs": "~2.7.1",
        "@tauri-apps/plugin-global-shortcut": "~2.4.1",
        "@tauri-apps/plugin-http": "~2.8.3",
        "@tauri-apps/plugin-notification": "~2.7.0",
        "@tauri-apps/plugin-os": "~2.4.0",
        "@tauri-apps/plugin-process": "~2.4.0",
        "@tauri-apps/plugin-shell": "~2.5.0",
        "ctool-adapter-base": "workspace:*",
        "ctool-config": "workspace:*"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.12.3",
        "@types/node": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "unrun": "catalog:"
    }
}
