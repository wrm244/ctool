{
    "$schema": "https://schema.tauri.app/config/2",
    "identifier": "org.baiy.ctool-tauri",
    "productName": "ctool",
    "version": "##version##",
    "build": {
        "beforeDevCommand": "",
        "beforeBuildCommand": "",
        "frontendDist": "../dist/web"
    },
    "bundle": {
        "active": true,
        "category": "DeveloperTool",
        "copyright": "",
        "externalBin": [],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "longDescription": "##description##",
        "targets": [
            "deb",
            "appimage",
            "msi",
            "app",
            "dmg"
        ],
        "macOS": {},
        "windows": {
            "digestAlgorithm": "sha256"
        }
    },
    "app": {
        "withGlobalTauri": true,
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
        },
        "windows": [
            {
                "fullscreen": false,
                "height": 650,
                "resizable": true,
                "title": "Ctool 程序开发常用工具",
                "width": 900
            }
        ]
    },
    "plugins": {
        "updater": {
            "active": false
        }
    }
}
