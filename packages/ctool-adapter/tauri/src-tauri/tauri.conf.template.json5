{
    "$schema": "https://schema.tauri.app/config/2",
    "identifier": "org.baiy.ctool-tauri",
    "productName": "ctool",
    "version": "##version##",
    "build": {
        "beforeDevCommand": "",
        "beforeBuildCommand": "",
        "frontendDist": "../dist/web"
    },
    "bundle": {
        "active": true,
        "category": "DeveloperTool",
        "copyright": "",
        "externalBin": [],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "longDescription": "##description##",
        "targets": [
            "deb",
            "appimage",
            // Windows 只发编译出的 exe，不打 msi 安装包
            "app",
            "dmg"
        ],
        "macOS": {},
        "windows": {
            "digestAlgorithm": "sha256"
        }
    },
    "app": {
        "withGlobalTauri": true,
        "security": {
            "csp": "default-src 'self'; connect-src 'self' ipc://localhost https:; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:",
            // style-src 禁止 Tauri 注入 nonce/hash：应用依赖运行时注入的样式（Monaco、Element Plus），
            // 而 CSP3 规定 style-src 一旦带 nonce/hash，'unsafe-inline' 即失效，这些样式会被全部拒绝。
            // 前端 HTML 也已不再写内联 <style>（骨架样式改为外链），这里做第二层防护。
            "dangerousDisableAssetCspModification": ["style-src"],
            "capabilities": ["desktop-capability"]
        },
        "windows": [
            {
                // 桌面端直接用本地打包页面，不再经过 index.html 中转（也就没有中转页骨架/白屏）
                "url": "tool.html",
                "fullscreen": false,
                "height": 650,
                "minHeight": 300,
                "minWidth": 500,
                "resizable": true,
                "title": "Ctool 程序开发常用工具",
                "width": 900,
                "useHttpsScheme": true
            }
        ]
    },
    "plugins": {
        "updater": {
            "active": false
        }
    }
}
